<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.plainly</groupId>
    <artifactId>plainly-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>plainly-driver-jdbc</artifactId>
  <name>Plainly :: JDBC 驱动实现</name>
  <description>
    契约的 JDBC 实现。精度保真在 CellReader 一处完成，
    由 PrecisionConformanceTest 守门——新增数据库的准入门槛是通过该测试，不是「能连上」。
  </description>

  <dependencies>
    <dependency>
      <groupId>com.plainly</groupId>
      <artifactId>plainly-driver-api</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- SSH 隧道：跳板机后面的库 -->
    <dependency>
      <groupId>com.github.mwiede</groupId>
      <artifactId>jsch</artifactId>
    </dependency>

    <!-- Oracle -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc8</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 达梦 DM8 -->
    <dependency>
      <groupId>com.dameng</groupId>
      <artifactId>DmJdbcDriver18</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- SQL Server -->
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
    </dependency>

    <!--
      国产数据库三家。都还没在真实实例上验证过，见 DbType 里各自的说明。

      opengauss-jdbc 必须用 -og 后缀那个变体：不带后缀的把类放在 org.postgresql 包下，
      注册的驱动类也叫 org.postgresql.Driver，和真正的 PostgreSQL 驱动同名。
      两个一起在 classpath 上时，用哪个取决于谁先被加载——而且不会有任何报错。
    -->
    <dependency>
      <groupId>cn.com.kingbase</groupId>
      <artifactId>kingbase8</artifactId>
    </dependency>
    <dependency>
      <groupId>com.oceanbase</groupId>
      <artifactId>oceanbase-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.opengauss</groupId>
      <artifactId>opengauss-jdbc</artifactId>
    </dependency>

    <!-- 一致性测试用的嵌入式库：无需 Docker，CI 直接可跑，且 DECIMAL(38,10) 语义完整 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
