<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.plainly</groupId>
    <artifactId>plainly-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>plainly-core</artifactId>
  <name>Plainly :: 核心服务</name>
  <description>连接注册表、凭据存储、查询调度、导出。不依赖 JavaFX，可脱离界面测试。</description>

  <dependencies>
    <dependency>
      <groupId>com.plainly</groupId>
      <artifactId>plainly-driver-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.plainly</groupId>
      <artifactId>plainly-driver-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.plainly</groupId>
      <artifactId>plainly-driver-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.plainly</groupId>
      <artifactId>plainly-driver-mongo</artifactId>
    </dependency>

    <!-- 本地配置库 -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>

    <!-- Windows DPAPI（Crypt32Util）——口令加密绑定当前用户账户 -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna-platform</artifactId>
    </dependency>

    <!-- 任务通知发信 -->
    <dependency>
      <groupId>com.sun.mail</groupId>
      <artifactId>jakarta.mail</artifactId>
    </dependency>

    <!-- 导入的一致性测试同样跑在嵌入式 H2 上 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- xlsx 导出 -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
    </dependency>
  </dependencies>
</project>
